{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "mcm_api",
    "Audience": "mcm_api",
    "ExpiryMinutes": 60
  },
  "FileConfiguration": {
    "document": {
      "storage": "uploads/documents"
    },
    "image": {
      "storage": "uploads/images"
    }
  }
}
